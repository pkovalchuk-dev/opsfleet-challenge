# Copy to .env (never commit .env). Get a Gemini key from Google AI Studio.
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Optional overrides
GEMINI_MODEL=gemini-3.5-flash-lite
# One fallback for temporary failures; blank or the primary model id disables it.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# GEMINI_THINKING_BUDGET=0
# LangSmith: create an API key in Settings > API Keys. Keep it in .env only.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=opsfleet-challenge
# EU workspaces: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=your-workspace-id  # if your key accesses multiple workspaces
# Agent-based workspaces: use these instead of LANGSMITH_PROJECT, after registering the agent.
# LANGSMITH_AGENT_ID=opsfleet-challenge
# LANGSMITH_AGENT_ENVIRONMENT=development
